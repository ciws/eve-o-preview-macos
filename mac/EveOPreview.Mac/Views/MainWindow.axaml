<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveOPreview.Mac.ViewModels"
        xmlns:models="using:EveOPreview.Mac.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="540"
        x:Class="EveOPreview.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/icon.png"
        Title="{Binding Title}"
        Width="720"
        Height="460"
        MinWidth="520"
        MinHeight="340">
    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="74" />
        </Style>
    </Window.Styles>

    <!-- Panel colours follow the system theme so text stays readable in Light Mode. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ClientListBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ClientListBorderBrush" Color="#D6D6D6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#141414" />
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="ClientListBackgroundBrush" Color="#151515" />
                    <SolidColorBrush x:Key="ClientListBorderBrush" Color="#2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{Binding Title}"
                        FontSize="17"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Text="Compact EVE client switcher and live preview controller"
                        Opacity="0.68"
                        FontSize="11" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Classes="toolbar"
                        Content="Save"
                        Command="{Binding SaveSettingsCommand}" />
                    <Button
                        Classes="toolbar"
                        Content="Refresh"
                        Command="{Binding RefreshClientsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="12,8"
                Margin="0,0,0,10"
                CornerRadius="8"
                Background="{DynamicResource StatusBackgroundBrush}"
                BorderBrush="{DynamicResource StatusBorderBrush}"
                BorderThickness="1">
            <TextBlock
                Text="{Binding Status}"
                TextWrapping="Wrap"
                FontSize="13" />
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Clients">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0" RowSpacing="10">
                    <TextBlock
                        Text="Detected clients"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Opacity="0.84" />

                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource ClientListBackgroundBrush}"
                        BorderBrush="{DynamicResource ClientListBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4"
                        MinHeight="120">
                        <ListBox
                            ItemsSource="{Binding Clients}"
                            SelectedItem="{Binding SelectedClient}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ClientWindowInfo">
                                    <Border Padding="8,6" CornerRadius="6">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{Binding WindowTitle}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding ProcessName}"
                                                FontSize="11"
                                                Opacity="0.68" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Content="Activate selected client"
                            Command="{Binding ActivateSelectedCommand}"
                            Padding="14,8" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="General">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Track client locations" IsChecked="{Binding TrackClientLocations}" />
                        <CheckBox Content="Hide preview of active EVE client (coming soon)" IsChecked="{Binding HidePreviewOfActiveClient}" IsEnabled="False" />
                        <CheckBox Content="Minimize inactive EVE clients (coming soon)" IsChecked="{Binding MinimizeInactiveClients}" IsEnabled="False" />
                        <CheckBox Content="Previews always on top" IsChecked="{Binding PreviewsAlwaysOnTop}" />
                        <CheckBox Content="Hide previews when EVE client is not active (coming soon)" IsChecked="{Binding HidePreviewsWhenClientNotActive}" IsEnabled="False" />
                        <CheckBox Content="Unique layout for each EVE client (coming soon)" IsChecked="{Binding UniqueLayoutForEachClient}" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Thumbnail">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding ThumbnailOpacity, StringFormat='Opacity: {0}%'}" />
                        <Slider Minimum="20" Maximum="100" Value="{Binding ThumbnailOpacity}" />
                        <TextBlock Text="{Binding ThumbnailWidth, StringFormat='Width: {0}'}" />
                        <Slider Minimum="100" Maximum="640" Value="{Binding ThumbnailWidth}" />
                        <TextBlock Text="{Binding ThumbnailHeight, StringFormat='Height: {0}'}" />
                        <Slider Minimum="80" Maximum="400" Value="{Binding ThumbnailHeight}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Zoom">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Zoom on hover (coming soon)" IsChecked="{Binding ZoomOnHover}" IsEnabled="False" />
                        <TextBlock Text="{Binding ZoomFactor, StringFormat='Zoom factor: {0}'}" />
                        <Slider Minimum="2" Maximum="10" Value="{Binding ZoomFactor}" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Overlay">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Show title overlay" IsChecked="{Binding ShowOverlay}" />
                        <CheckBox Content="Show frames (coming soon)" IsChecked="{Binding ShowFrames}" IsEnabled="False" />
                        <CheckBox Content="Highlight active client (coming soon)" IsChecked="{Binding HighlightActiveClient}" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Config">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Implemented now: thumbnail size, opacity, always-on-top, title overlay visibility, and persistent thumbnail positions." TextWrapping="Wrap" />
                        <TextBlock Text="Disabled controls are placeholders for features that are not wired up in the macOS port yet." TextWrapping="Wrap" />
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Width="140" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
